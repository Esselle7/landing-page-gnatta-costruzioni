---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteData from '../data/site.json';
const { aboutPage, company } = siteData;
---

<BaseLayout
  title="Chi Siamo"
  seoTitle="Chi Siamo | Costruzioni Gnatta - Impresa Edile dal 1970"
  description="Scopri la storia di Costruzioni Gnatta, impresa edile a Como e Varese con oltre 55 anni di esperienza. Tre generazioni di eccellenza nelle costruzioni residenziali, ville e palazzine in classe A in tutta la Lombardia."
  pageType="AboutPage"
  breadcrumbs={[{ name: "Chi Siamo", href: "/chi-siamo/" }]}
>

  <!-- Page Header -->
  <section class="relative pt-40 pb-24 overflow-hidden">
    <div class="absolute inset-0"
         style="background-image: url('/images/placeholder.webp');
                background-size: cover;
                background-position: center;">
    </div>
    <div class="absolute inset-0" style="background: rgba(10,8,6,0.72);"></div>
    <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
      <span class="gold-line"></span>
      <h1 class="font-display text-7xl md:text-8xl text-stone-100 font-light leading-none mb-6">
        Impresa Edile <em class="text-brand-400 not-italic">Como dal 1970</em>
      </h1>
      <p class="font-body text-xl text-stone-400 max-w-2xl leading-relaxed">
        {aboutPage.intro}
      </p>
    </div>
  </section>

  <!-- Story Section -->
  <section class="bg-stone-950 py-28">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
        <div class="reveal-left">
          <span class="gold-line"></span>
          <h2 class="font-display text-4xl md:text-5xl text-stone-100 font-light mb-8">
            La Nostra <em class="text-brand-400 not-italic">Storia</em>
          </h2>
          <p class="font-body text-stone-400 leading-relaxed mb-6">
            {aboutPage.story}
          </p>
          <p class="font-body text-stone-400 leading-relaxed">
            {aboutPage.storyContinue}
          </p>
        </div>

        <div class="reveal-right">
          <div class="relative">
            <img
  src="/images/logo.png"
  alt="Costruzioni Gnatta - La nostra storia"
  class="w-full h-auto object-cover"
  width="300"
  height="300"
/>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission & Approach -->
  <section class="bg-stone-900 py-28">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <div class="reveal">
          <span class="gold-line"></span>
          <h2 class="font-display text-4xl text-stone-100 font-light mb-6">
            La Nostra <em class="text-brand-400 not-italic">Mission</em>
          </h2>
          <p class="font-body text-stone-400 leading-relaxed text-lg">
            {aboutPage.mission}
          </p>
        </div>
        <div class="reveal delay-200">
          <span class="gold-line"></span>
          <h2 class="font-display text-4xl text-stone-100 font-light mb-6">
            Il Nostro <em class="text-brand-400 not-italic">Approccio</em>
          </h2>
          <p class="font-body text-stone-400 leading-relaxed text-lg">
            {aboutPage.approach}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="bg-stone-950 py-28">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-20 reveal">
        <span class="gold-line mx-auto"></span>
        <h2 class="font-display text-5xl text-stone-100 font-light">
          La Nostra <em class="text-brand-400 not-italic">Timeline</em>
        </h2>
      </div>

      <div class="relative">
        <!-- Vertical line -->
        <div class="absolute left-1/2 top-0 bottom-0 w-px bg-stone-800 -translate-x-1/2 hidden md:block"></div>

        <div class="space-y-12">
          {aboutPage.timeline.map((item, i) => (
            <div class={`reveal delay-${i * 100 + 100} flex flex-col md:flex-row items-center gap-8 ${
              i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'
            }`}>
              <!-- Content -->
              <div class={`flex-1 ${i % 2 === 0 ? 'md:text-right' : 'md:text-left'}`}>
                <div class="bg-stone-900 border border-stone-800 p-6 hover:border-brand-700 transition-colors duration-300">
                  <span class="font-display text-5xl text-brand-400/30 font-light">{item.year}</span>
                  <p class="font-body text-stone-300 mt-2">{item.event}</p>
                </div>
              </div>

              <!-- Center dot -->
              <div class="hidden md:flex w-4 h-4 rounded-full border-2 border-brand-500 bg-stone-950
                          flex-shrink-0 relative z-10">
              </div>

              <!-- Spacer -->
              <div class="flex-1 hidden md:block"></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-stone-900 border-t border-stone-800 py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="reveal">
        <h3 class="font-display text-3xl text-stone-100 font-light mb-2">
          Pronto a iniziare?
        </h3>
        <p class="font-body text-stone-400">Contattaci per un primo incontro senza impegno.</p>
      </div>
      <a href="/contatti" class="btn-primary reveal delay-200 flex-shrink-0">
        Parlaci del tuo progetto
      </a>
    </div>
  </section>

</BaseLayout>
