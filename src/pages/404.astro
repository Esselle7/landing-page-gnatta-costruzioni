---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pagina non trovata" noIndex={true}>
  <section class="min-h-screen flex items-center justify-center bg-stone-950">
    <div class="text-center px-6">
      <span class="font-display text-[12rem] text-stone-800 font-light leading-none block">404</span>
      <span class="gold-line mx-auto"></span>
      <h1 class="font-display text-4xl text-stone-100 font-light mb-4">
        Pagina non trovata
      </h1>
      <p class="font-body text-stone-400 mb-8">
        La pagina che cerchi non esiste o è stata spostata.
      </p>
      <a href="/" class="btn-primary">Torna alla Home</a>
    </div>
  </section>
</BaseLayout>
