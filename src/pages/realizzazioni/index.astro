---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RealizzioneCard from '../../components/RealizzioneCard.astro';
import realizzazioni from '../../data/realizzazioni.json';
---

<BaseLayout
  title="Realizzazioni"
  seoTitle="Realizzazioni Edili Como e Varese | Costruzioni Gnatta"
  description="Portfolio realizzazioni di Costruzioni Gnatta: complessi residenziali, ville e palazzine costruiti nelle province di Como e Varese. Oltre 75 progetti completati in 55 anni di attività. Edilizia civile di qualità in Lombardia."
  pageType="CollectionPage"
  breadcrumbs={[{ name: "Realizzazioni", href: "/realizzazioni/" }]}
>

  <!-- Header -->
  <section class="relative pt-40 pb-24">
    <div class="absolute inset-0"
         style="background-image: url('/images/placeholder.webp');
                background-size: cover;
                background-position: center;">
    </div>
    <div class="absolute inset-0" style="background: rgba(10,8,6,0.72);"></div>
    <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
      <span class="gold-line"></span>
      <h1 class="font-display text-7xl md:text-8xl text-stone-100 font-light leading-none mb-6">
        Le Nostre <em class="text-brand-400 not-italic">Realizzazioni</em>
      </h1>
      <p class="font-body text-xl text-stone-400 max-w-2xl">
        Costruzioni residenziali nelle province di Como e Varese: complessi di appartamenti, palazzine e ville consegnate con cura artigianale dal 1970.
      </p>
    </div>
  </section>

  <!-- Grid -->
  <section class="bg-stone-950 py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {realizzazioni.map((r, i) => (
          <div class={`reveal delay-${(i % 3) * 100 + 100}`}>
            <RealizzioneCard {...r} />
          </div>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
