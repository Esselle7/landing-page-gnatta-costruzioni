---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ImageGallery from '../../../components/ImageGallery.astro';
import properties from '../../../data/properties.json';

export function getStaticPaths() {
  return properties.map((property) => ({
    params: { id: property.id },
    props: { property },
  }));
}

const { property } = Astro.props;

const badgeClass: Record<string, string> = {
  'in-vendita': 'badge-vendita',
  'prossimamente': 'badge-prossima',
  'venduto': 'badge-venduto',
};

const contactUrl = `/contatti?interesse=unita-vendita&unita=${property.id}&titolo=${encodeURIComponent(property.title)}`;
---

<BaseLayout
  title={property.title}
  seoTitle={`${property.title} in Vendita | Costruzioni Gnatta Como`}
  description={`${property.description} ${property.features?.slice(0,3).join(', ')}. Costruzioni Gnatta, impresa edile nelle province di Como e Varese. Richiedi informazioni.`}
  ogImage={property.coverImage}
  breadcrumbs={[
    { name: "Unità in Vendita", href: "/unita-in-vendita/" },
    { name: property.title, href: `/unita-in-vendita/${property.id}/` }
  ]}
>

  <!-- Back link -->
  <div class="pt-28 pb-6 bg-stone-950">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <a href="/unita-in-vendita"
         class="inline-flex items-center gap-2 font-body text-xs tracking-widest uppercase
                text-stone-500 hover:text-brand-400 transition-colors duration-200">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Tutte le Unità
      </a>
    </div>
  </div>

  <!-- Main content -->
  <section class="bg-stone-950 pb-28">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">

        <!-- Left: Gallery + details -->
        <div class="lg:col-span-2">

          <div class="mb-10 reveal">
            <ImageGallery images={property.images} title={property.title} />
          </div>

          <div class="reveal">
            <div class="flex items-center gap-4 mb-6">
              <span class={badgeClass[property.status] ?? 'badge-prossima'}>
                {property.statusLabel}
              </span>
              <span class="font-body text-xs text-stone-500 tracking-wide">{property.type}</span>
            </div>

            <h1 class="font-display text-5xl md:text-6xl text-stone-100 font-light mb-4">
              {property.title}
            </h1>

            <div class="flex items-center gap-2 mb-8">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" class="text-brand-500">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
                <circle cx="12" cy="9" r="2.5"/>
              </svg>
              <span class="font-body text-stone-400">{property.location}</span>
            </div>

            <p class="font-body text-stone-300 leading-relaxed text-lg">
              {property.longDescription}
            </p>
          </div>

          <!-- Features -->
          <div class="mt-12 reveal">
            <span class="gold-line"></span>
            <h2 class="font-display text-3xl text-stone-100 font-light mb-8">
              Caratteristiche
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              {property.features.map((feature: string) => (
                <div class="flex items-center gap-3 py-3 border-b border-stone-800">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                       stroke-width="2" class="text-brand-500 flex-shrink-0">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <span class="font-body text-sm text-stone-300">{feature}</span>
                </div>
              ))}
            </div>
          </div>

        </div>

        <!-- Right: sidebar -->
        <div class="lg:col-span-1">
          <div class="sticky top-28 space-y-6">

            <!-- Units -->
            <div class="bg-stone-900 border border-stone-800 p-6 reveal">
              <h3 class="font-display text-2xl text-stone-100 font-light mb-1">
                Unità Disponibili
              </h3>
              <p class="font-body text-xs text-stone-500 tracking-wide mb-5">
                Clicca su un'unità per i dettagli
              </p>
              <div class="space-y-2.5">
                {property.units.map((unit: any) => (
                  <div class={`unit-card-3d ${unit.available ? 'is-available' : 'is-sold'}`}>
                    {unit.available && unit.id ? (
                      <a
                        href={`/unita-in-vendita/${property.id}/${unit.id}`}
                        class="unit-card-inner unit-card-link"
                        aria-label={`Dettagli ${unit.title ?? unit.type}`}
                      >
                        <div class="flex justify-between items-center mb-2.5">
                          <span class="font-display text-lg text-stone-100 leading-none">{unit.type}</span>
                          <span class="available-badge">
                            <span class="available-dot"></span>
                            Disponibile
                          </span>
                        </div>
                        <div class="grid grid-cols-2 gap-x-3 gap-y-2">
                          <div>
                            <span class="detail-label">Superficie</span>
                            <span class="detail-value">{unit.size}</span>
                          </div>
                          <div>
                            <span class="detail-label">Piano</span>
                            <span class="detail-value">{unit.floor}</span>
                          </div>
                        </div>
                        <div class="discover-hint">
                          Scopri
                          <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                          </svg>
                        </div>
                      </a>
                    ) : (
                      <div class="unit-card-inner">
                        <div class="flex justify-between items-center mb-2.5">
                          <span class="font-display text-lg text-stone-100 leading-none">{unit.type}</span>
                          <span class="unit-sold-badge">Venduto</span>
                        </div>
                        <div class="grid grid-cols-2 gap-x-3 gap-y-2">
                          <div>
                            <span class="detail-label">Superficie</span>
                            <span class="detail-value">{unit.size}</span>
                          </div>
                          <div>
                            <span class="detail-label">Piano</span>
                            <span class="detail-value">{unit.floor}</span>
                          </div>
                        </div>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>

            <!-- Contact CTA -->
            <div class="bg-stone-900 border border-brand-700 p-6 reveal delay-200">
              <h3 class="font-display text-2xl text-stone-100 font-light mb-2">Interessato?</h3>
              <p class="font-body text-sm text-stone-400 mb-6">
                Contattaci per informazioni, prezzi e per fissare una visita.
              </p>
              <a href={contactUrl} class="btn-primary w-full justify-center mb-3">
                Richiedi Informazioni
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
              <a href="tel:031941378" class="btn-outline w-full justify-center text-xs">
                Chiama Ora
              </a>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>


<!-- ============================================================
     STYLES — unit cards only (overlay rimosso)
     ============================================================ -->
<style>
  .detail-label {
    display: block;
    font-family: var(--font-body, sans-serif);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #57534e;
    margin-bottom: 1px;
  }

  .detail-value {
    font-family: var(--font-body, sans-serif);
    font-size: 0.8rem;
    color: #d6d3d1;
  }

  .unit-card-3d { perspective: 900px; }

  .unit-card-inner {
    position: relative;
    display: block;
    padding: 0.875rem 1rem;
    border: 1px solid rgba(120, 113, 108, 0.18);
    border-radius: 2px;
    background: linear-gradient(145deg, #1c1917 0%, #141210 100%);
    transition:
      transform 0.38s cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 0.38s cubic-bezier(0.23, 1, 0.32, 1),
      border-color 0.28s;
    transform-style: preserve-3d;
    will-change: transform;
    overflow: hidden;
    text-decoration: none;
  }

  .unit-card-inner::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(200, 131, 42, 0.07) 0%, transparent 55%);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  .unit-card-link:hover {
    box-shadow:
      0 20px 55px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(200, 131, 42, 0.4),
      inset 0 1px 0 rgba(200, 131, 42, 0.1);
    border-color: rgba(200, 131, 42, 0.45);
    transform: translateY(-2px);
  }

  .unit-card-link:hover::before { opacity: 1; }

  .unit-card-3d.is-sold .unit-card-inner { opacity: 0.4; }

  .discover-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    margin-top: 0.6rem;
    padding-top: 0.55rem;
    border-top: 1px solid rgba(200, 131, 42, 0.1);
    font-family: var(--font-body, sans-serif);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(200, 131, 42, 0.4);
    transition: color 0.22s;
  }

  .unit-card-link:hover .discover-hint {
    color: rgba(200, 131, 42, 0.85);
  }

  .available-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    font-family: var(--font-body, sans-serif);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c8832a;
    padding: 0.15rem 0.5rem;
    border: 1px solid rgba(200, 131, 42, 0.3);
    border-radius: 1px;
    flex-shrink: 0;
  }

  .available-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #c8832a;
    animation: pulse-gold 2s infinite;
    flex-shrink: 0;
  }

  @keyframes pulse-gold {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.4; transform: scale(0.7); }
  }

  .unit-sold-badge {
    font-family: var(--font-body, sans-serif);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #44403c;
    padding: 0.15rem 0.5rem;
    border: 1px solid rgba(68, 64, 60, 0.25);
    border-radius: 1px;
    flex-shrink: 0;
  }
</style>