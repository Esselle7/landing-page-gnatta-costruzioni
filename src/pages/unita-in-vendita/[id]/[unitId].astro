<!-- ============================================================
     SCRIPTS
     ============================================================ -->
<script>
  /* ─── Scroll reveal ────────────────────────────────────────── */
  const revealEls = document.querySelectorAll<HTMLElement>('.ud-reveal');
  const revealObs = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          (entry.target as HTMLElement).classList.add('is-visible');
          revealObs.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
  );
  revealEls.forEach(el => revealObs.observe(el));

  /* ─── Hero thumbnail switcher ──────────────────────────────── */
  const heroImg  = document.querySelector<HTMLImageElement>('.ud-hero-img');
  const allSrcs  = JSON.parse(document.getElementById('ud-images-data')?.textContent ?? '[]') as string[];

  document.querySelectorAll<HTMLButtonElement>('.ud-thumb').forEach(btn => {
    btn.addEventListener('click', () => {
      if (!heroImg) return;
      const idx = parseInt(btn.dataset.index ?? '0', 10);
      const src = allSrcs[idx];
      if (src) {
        heroImg.style.opacity = '0';
        heroImg.style.transition = 'opacity 0.3s';
        setTimeout(() => {
          heroImg.src = src;
          heroImg.style.opacity = '1';
        }, 300);
      }
    });
  });

  /* ─── Lightbox ─────────────────────────────────────────────── */
  const lb        = document.getElementById('ud-lightbox') as HTMLElement;
  const lbBackdrop= document.getElementById('ud-lb-backdrop') as HTMLElement;
  const lbClose   = document.getElementById('ud-lb-close') as HTMLButtonElement;
  const lbPrev    = document.getElementById('ud-lb-prev') as HTMLButtonElement;
  const lbNext    = document.getElementById('ud-lb-next') as HTMLButtonElement;
  const lbImg     = document.getElementById('ud-lb-img') as HTMLImageElement;
  const lbCounter = document.getElementById('ud-lb-counter') as HTMLElement;

  let lbIndex = 0;
  let lbImages: string[] = allSrcs;
  let lbLastFocus: HTMLElement | null = null;

  function lbOpen(index: number): void {
    if (!lbImages.length) return;
    lbLastFocus = document.activeElement as HTMLElement;
    lbIndex = index;
    lbShow();
    lb.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    setTimeout(() => lbClose.focus(), 60);
  }

  function lbShow(): void {
    lbImg.style.opacity = '0';
    lbImg.style.transform = 'scale(0.96)';
    setTimeout(() => {
      lbImg.src = lbImages[lbIndex];
      lbImg.alt = 'Foto ' + (lbIndex + 1);
      lbCounter.textContent = (lbIndex + 1) + ' / ' + lbImages.length;
      lbImg.style.opacity = '1';
      lbImg.style.transform = 'scale(1)';
    }, 120);
  }

  function lbClose_(): void {
    lb.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    lbLastFocus?.focus();
  }

  lbClose.addEventListener('click', lbClose_);
  lbBackdrop.addEventListener('click', lbClose_);
  lbPrev.addEventListener('click', () => { lbIndex = (lbIndex - 1 + lbImages.length) % lbImages.length; lbShow(); });
  lbNext.addEventListener('click', () => { lbIndex = (lbIndex + 1) % lbImages.length; lbShow(); });

  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (lb.getAttribute('aria-hidden') === 'true') return;
    if (e.key === 'Escape') lbClose_();
    if (e.key === 'ArrowLeft') { lbIndex = (lbIndex - 1 + lbImages.length) % lbImages.length; lbShow(); }
    if (e.key === 'ArrowRight') { lbIndex = (lbIndex + 1) % lbImages.length; lbShow(); }
  });

  /* Wire gallery items */
  document.querySelectorAll<HTMLButtonElement>('[data-gallery-open]').forEach(btn => {
    btn.addEventListener('click', () => {
      lbOpen(parseInt(btn.dataset.galleryOpen ?? '0', 10));
    });
  });

  /* Wire thumb "more" button */
  document.querySelector<HTMLButtonElement>('[data-open-gallery]')?.addEventListener('click', () => {
    lbOpen(5);
  });
</script>

