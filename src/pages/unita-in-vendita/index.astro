---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import properties from '../../data/properties.json';
---

<BaseLayout
  title="Unità in Vendita"
  seoTitle="Appartamenti e Ville in Vendita Como e Varese | Costruzioni Gnatta"
  description="Appartamenti, trilocali, quadrilocali e ville in vendita nelle province di Como e Varese. Costruzioni Gnatta propone soluzioni residenziali in classe A con pompa di calore e pannelli fotovoltaici. Scopri le disponibilità."
  pageType="CollectionPage"
  breadcrumbs={[{ name: "Unità in Vendita", href: "/unita-in-vendita/" }]}
>

  <!-- Header -->
  <section class="relative pt-40 pb-24">
    <div class="absolute inset-0" style="background: #000;"></div>
    <div class="relative max-w-7xl mx-auto px-6 lg:px-8">
      <span class="gold-line"></span>
      <h1 class="font-display text-7xl md:text-8xl text-stone-100 font-light leading-none mb-6">
        Appartamenti e Ville in <em class="text-brand-400 not-italic">Vendita</em>
      </h1>
      <p class="font-body text-xl text-stone-400 max-w-2xl">
        Soluzioni abitative di qualità nelle province di Como e Varese — classe energetica A, impianti moderni, finiture di pregio.
      </p>
    </div>
  </section>

  <!-- Filter bar -->
  <div class="bg-stone-900 border-b border-stone-800 sticky top-20 z-40">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-4 flex items-center gap-6 overflow-x-auto">
      <span class="font-body text-xs tracking-widest uppercase text-stone-500 flex-shrink-0">Filtra:</span>
      {['Tutti', 'In Vendita', 'Prossimamente'].map((f) => (
        <button
          class="filter-btn font-body text-xs tracking-widest uppercase px-4 py-2 border
                 border-transparent text-stone-400 hover:text-stone-100 hover:border-stone-700
                 transition-all duration-200 flex-shrink-0 whitespace-nowrap"
          data-filter={f === 'Tutti' ? 'all' : f.toLowerCase().replace(' ', '-')}
        >
          {f}
        </button>
      ))}
    </div>
  </div>

  <!-- Grid -->
  <section class="bg-stone-950 py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="properties-grid">
        {properties.map((property, i) => (
          <div
            class={`reveal delay-${i * 100 + 100} property-item`}
            data-status={property.status}
          >
            <PropertyCard {...property} />
          </div>
        ))}
      </div>

      {properties.length === 0 && (
        <div class="text-center py-20">
          <p class="font-display text-3xl text-stone-600 font-light">
            Nessuna unità disponibile al momento.
          </p>
          <p class="font-body text-stone-500 mt-4">Contattaci per essere aggiornato sulle prossime disponibilità.</p>
        </div>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-stone-900 border-t border-stone-800 py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h3 class="font-display text-3xl text-stone-100 font-light mb-4">
        Non trovi quello che cerchi?
      </h3>
      <p class="font-body text-stone-400 mb-8">
        Parliaci del progetto dei tuoi sogni. Possiamo costruirlo su misura per te.
      </p>
      <a href="/contatti" class="btn-primary">
        Contattaci
      </a>
    </div>
  </section>

</BaseLayout>

<!-- ============================================================
     UNIT DETAIL OVERLAY MODAL
     ============================================================ -->
<div
  id="unit-overlay"
  class="unit-overlay"
  role="dialog"
  aria-modal="true"
  aria-label="Dettaglio unità"
>
  <!-- Backdrop -->
  <div id="overlay-backdrop" class="overlay-backdrop"></div>

  <!-- Panel -->
  <div class="overlay-panel" id="overlay-panel">

    <!-- Close button -->
    <button id="overlay-close" class="overlay-close" aria-label="Chiudi">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>

    <!-- Photo gallery -->
    <div id="overlay-gallery" class="overlay-gallery"></div>

    <!-- Content -->
    <div class="overlay-content">
      <!-- Status badge -->
      <div class="overlay-badge">
        <span class="badge-dot"></span>
        Disponibile
      </div>

      <!-- Title -->
      <h2 id="overlay-title" class="overlay-title"></h2>

      <!-- Description -->
      <p id="overlay-description" class="overlay-description"></p>

      <!-- Specs grid -->
      <div id="overlay-specs" class="overlay-specs"></div>

      <!-- Price -->
      <div class="overlay-price-block">
        <span class="price-label">Prezzo</span>
        <span id="overlay-price" class="price-value"></span>
      </div>

      <!-- CTA -->
      <a href="/contatti" class="overlay-cta">
        Richiedi informazioni
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</div>

<!-- ============================================================
     STYLES
     ============================================================ -->
<style>
  /* ---------- 3D unit card ---------- */
  .unit-card-3d {
    perspective: 900px;
    cursor: pointer;
  }

  .unit-card-inner {
    position: relative;
    background: linear-gradient(145deg, #1c1917 0%, #141210 100%);
    border: 1px solid rgba(200, 131, 42, 0.15);
    border-radius: 2px;
    padding: 1.25rem 1.5rem;
    transition:
      transform 0.35s cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 0.35s cubic-bezier(0.23, 1, 0.32, 1),
      border-color 0.25s ease;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .unit-card-3d.is-available .unit-card-inner:hover {
    transform: rotateX(-4deg) rotateY(4deg) translateY(-6px) scale(1.02);
    box-shadow:
      0 20px 60px rgba(0,0,0,0.6),
      0 0 0 1px rgba(200, 131, 42, 0.4),
      inset 0 1px 0 rgba(200, 131, 42, 0.1);
    border-color: rgba(200, 131, 42, 0.5);
  }

  /* Shine sweep on hover */
  .unit-card-inner::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 2px;
    background: linear-gradient(
      135deg,
      rgba(200, 131, 42, 0.08) 0%,
      transparent 50%
    );
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  .unit-card-3d.is-available .unit-card-inner:hover::before {
    opacity: 1;
  }

  /* Clickable indicator */
  .unit-card-3d.is-available .unit-card-inner::after {
    content: 'Scopri →';
    position: absolute;
    bottom: 1rem;
    right: 1.25rem;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(200, 131, 42, 0.5);
    transition: color 0.25s, opacity 0.25s;
    font-family: var(--font-body, sans-serif);
    opacity: 0;
  }

  .unit-card-3d.is-available .unit-card-inner:hover::after {
    opacity: 1;
    color: rgba(200, 131, 42, 0.9);
  }

  /* Sold badge */
  .unit-sold-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #78716c;
    padding: 0.2rem 0.6rem;
    border: 1px solid rgba(120, 113, 108, 0.3);
    border-radius: 1px;
  }

  .available-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c8832a;
    padding: 0.2rem 0.6rem;
    border: 1px solid rgba(200, 131, 42, 0.35);
    border-radius: 1px;
    margin-bottom: 0.5rem;
  }

  .available-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #c8832a;
    animation: pulse-gold 2s infinite;
  }

  @keyframes pulse-gold {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
  }

  /* ---------- OVERLAY ---------- */
  .unit-overlay {
    position: fixed;
    inset: 0;
    z-index: 9000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .unit-overlay.is-open {
    pointer-events: all;
    opacity: 1;
  }

  .overlay-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(8, 6, 4, 0.88);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .overlay-panel {
    position: relative;
    z-index: 1;
    background: linear-gradient(160deg, #18140f 0%, #0f0d0b 100%);
    border: 1px solid rgba(200, 131, 42, 0.2);
    border-radius: 3px;
    width: 100%;
    max-width: 860px;
    max-height: 90svh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    box-shadow:
      0 40px 120px rgba(0,0,0,0.8),
      0 0 0 1px rgba(200, 131, 42, 0.08);
    transform: translateY(24px) scale(0.97);
    transition: transform 0.4s cubic-bezier(0.23, 1, 0.32, 1);

    /* Hide scrollbar but keep scroll */
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .overlay-panel::-webkit-scrollbar { display: none; }

  .unit-overlay.is-open .overlay-panel {
    transform: translateY(0) scale(1);
  }

  /* Close button */
  .overlay-close {
    position: sticky;
    top: 1rem;
    left: 100%;
    z-index: 10;
    margin: 1rem 1rem 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(200, 131, 42, 0.25);
    border-radius: 50%;
    background: rgba(15, 13, 11, 0.85);
    color: #a8a29e;
    cursor: pointer;
    flex-shrink: 0;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .overlay-close:hover {
    color: #c8832a;
    border-color: rgba(200, 131, 42, 0.6);
    background: rgba(15, 13, 11, 1);
  }

  /* Gallery */
  .overlay-gallery {
    width: 100%;
    overflow: hidden;
  }

  /* 1 photo */
  .gallery-1 {
    display: block;
  }
  .gallery-1 img {
    width: 100%;
    height: 340px;
    object-fit: cover;
  }

  /* 2 photos */
  .gallery-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
  }
  .gallery-2 img {
    width: 100%;
    height: 280px;
    object-fit: cover;
  }

  /* 3 photos */
  .gallery-3 {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 2px;
    height: 320px;
  }
  .gallery-3 img:first-child {
    grid-row: 1 / 3;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gallery-3 img:not(:first-child) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 4+ photos */
  .gallery-4 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 220px 140px;
    gap: 2px;
  }
  .gallery-4 img:first-child {
    grid-column: 1 / 3;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gallery-4 img:not(:first-child) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Content area */
  .overlay-content {
    padding: 2rem 2.5rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .overlay-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #c8832a;
    font-family: var(--font-body, sans-serif);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #c8832a;
    animation: pulse-gold 2s infinite;
  }

  .overlay-title {
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 300;
    color: #f5f0e8;
    line-height: 1.15;
    margin: 0;
  }

  .overlay-description {
    font-family: var(--font-body, sans-serif);
    font-size: 0.95rem;
    line-height: 1.75;
    color: #a8a29e;
    margin: 0;
  }

  /* Specs */
  .overlay-specs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1px;
    background: rgba(200, 131, 42, 0.08);
    border: 1px solid rgba(200, 131, 42, 0.1);
    border-radius: 2px;
    overflow: hidden;
  }

  .spec-item {
    background: rgba(15, 13, 11, 0.9);
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .spec-label {
    font-family: var(--font-body, sans-serif);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #57534e;
  }

  .spec-value {
    font-family: var(--font-body, sans-serif);
    font-size: 0.85rem;
    color: #d6d3d1;
    white-space: pre-line;
    line-height: 1.5;
  }

  /* Price block */
  .overlay-price-block {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    background: linear-gradient(90deg, rgba(200, 131, 42, 0.07) 0%, transparent 100%);
    border-left: 2px solid #c8832a;
    border-radius: 0 2px 2px 0;
  }

  .price-label {
    font-family: var(--font-body, sans-serif);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #78716c;
  }

  .price-value {
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    font-weight: 300;
    color: #c8832a;
    letter-spacing: -0.01em;
  }

  /* CTA */
  .overlay-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    align-self: flex-start;
    padding: 0.75rem 1.75rem;
    background: transparent;
    border: 1px solid rgba(200, 131, 42, 0.5);
    color: #c8832a;
    font-family: var(--font-body, sans-serif);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 1px;
    transition: background 0.25s, border-color 0.25s, color 0.25s, box-shadow 0.25s;
  }

  .overlay-cta:hover {
    background: rgba(200, 131, 42, 0.1);
    border-color: #c8832a;
    box-shadow: 0 0 20px rgba(200, 131, 42, 0.15);
  }

  /* Mobile adjustments */
  @media (max-width: 640px) {
    .overlay-panel {
      max-height: 95svh;
      border-radius: 4px 4px 0 0;
      align-self: flex-end;
      margin-bottom: 0;
    }

    .unit-overlay {
      align-items: flex-end;
      padding: 0;
    }

    .overlay-content {
      padding: 1.5rem 1.25rem 2rem;
    }

    .gallery-2 img,
    .gallery-3,
    .gallery-4 {
      height: auto;
    }

    .gallery-2 {
      grid-template-columns: 1fr;
    }
    .gallery-2 img {
      height: 200px;
    }

    .gallery-3 {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      height: auto;
    }
    .gallery-3 img {
      height: 180px;
    }
    .gallery-3 img:first-child {
      grid-row: auto;
    }

    .gallery-4 {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }
    .gallery-4 img {
      height: 180px;
    }
    .gallery-4 img:first-child {
      grid-column: auto;
      height: 220px;
    }

    .gallery-1 img {
      height: 220px;
    }

    .overlay-specs {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<!-- ============================================================
     SCRIPTS
     ============================================================ -->
<script>
  /* ---- Filter bar ---- */
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.property-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter!;
      filterBtns.forEach((b) => b.classList.remove('border-brand-500', 'text-brand-400'));
      btn.classList.add('border-brand-500', 'text-brand-400');
      items.forEach((item) => {
        item.style.display = (filter === 'all' || item.dataset.status === filter) ? '' : 'none';
      });
    });
  });
  filterBtns[0]?.classList.add('border-brand-500', 'text-brand-400');

  /* ---- Overlay ---- */
  const overlay   = document.getElementById('unit-overlay')!;
  const backdrop  = document.getElementById('overlay-backdrop')!;
  const closeBtn  = document.getElementById('overlay-close')!;
  const gallery   = document.getElementById('overlay-gallery')!;
  const titleEl   = document.getElementById('overlay-title')!;
  const descEl    = document.getElementById('overlay-description')!;
  const specsEl   = document.getElementById('overlay-specs')!;
  const priceEl   = document.getElementById('overlay-price')!;

  function openOverlay(unit: {
    title: string;
    description: string;
    price: string;
    type: string;
    size: string;
    floor: string;
    pert?: string;
    balcony?: string;
    images?: string[];
  }) {
    // Title & description
    titleEl.textContent = unit.title;
    descEl.textContent  = unit.description;
    priceEl.textContent = unit.price;

    // Gallery
    gallery.innerHTML = '';
    const imgs = (unit.images ?? []).slice(0, 4);
    const count = imgs.length;

    if (count > 0) {
      const wrapper = document.createElement('div');
      wrapper.className = count === 1 ? 'gallery-1'
                        : count === 2 ? 'gallery-2'
                        : count === 3 ? 'gallery-3'
                        : 'gallery-4';
      imgs.forEach((src) => {
        const img = document.createElement('img');
        img.src = src;
        img.alt = unit.title;
        img.loading = 'lazy';
        wrapper.appendChild(img);
      });
      gallery.appendChild(wrapper);
    }

    // Specs
    const specs = [
      { label: 'Tipologia',    value: unit.type },
      { label: 'Superficie',   value: unit.size },
      { label: 'Piano',        value: unit.floor },
      ...(unit.pert   ? [{ label: 'Pertinenze', value: unit.pert }]   : []),
      ...(unit.balcony ? [{ label: 'Spazi esterni', value: unit.balcony }] : []),
    ];

    specsEl.innerHTML = specs.map(s => `
      <div class="spec-item">
        <span class="spec-label">${s.label}</span>
        <span class="spec-value">${s.value}</span>
      </div>
    `).join('');

    // Open
    overlay.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeOverlay() {
    overlay.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  backdrop.addEventListener('click', closeOverlay);
  closeBtn.addEventListener('click', closeOverlay);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeOverlay();
  });

  /* ---- Wire up unit cards ---- */
  document.addEventListener('unit-card-click', (e: Event) => {
    const ce = e as CustomEvent;
    openOverlay(ce.detail);
  });
</script>