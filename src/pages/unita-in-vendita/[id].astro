---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageGallery from '../../components/ImageGallery.astro';
import properties from '../../data/properties.json';

export function getStaticPaths() {
  return properties.map((property) => ({
    params: { id: property.id },
    props: { property },
  }));
}

const { property } = Astro.props;

const badgeClass: Record<string, string> = {
  'in-vendita': 'badge-vendita',
  'prossimamente': 'badge-prossima',
  'venduto': 'badge-venduto',
};

// Build contact URL pre-filling unit and interest
const contactUrl = `/contatti?interesse=unita-vendita&unita=${property.id}&titolo=${encodeURIComponent(property.title)}`;

// Progress bar color based on percentage
function progressColor(pct: number): string {
  if (pct >= 100) return '#22c55e';  // green
  if (pct >= 60)  return '#c8832a';  // brand gold
  return '#78716c';                   // stone
}
---

<BaseLayout
  title={property.title}
  description={property.description}
  ogImage={property.coverImage}
>

  <!-- Back link -->
  <div class="pt-28 pb-6 bg-stone-950">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <a href="/unita-in-vendita"
         class="inline-flex items-center gap-2 font-body text-xs tracking-widest uppercase
                text-stone-500 hover:text-brand-400 transition-colors duration-200">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Tutte le Unità
      </a>
    </div>
  </div>

  <!-- Main content -->
  <section class="bg-stone-950 pb-28">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">

        <!-- Left: Gallery + details -->
        <div class="lg:col-span-2">

          <!-- Gallery -->
          <div class="mb-10 reveal">
            <ImageGallery images={property.images} title={property.title} />
          </div>

          <!-- Title + status -->
          <div class="reveal">
            <div class="flex items-center gap-4 mb-6">
              <span class={badgeClass[property.status] ?? 'badge-prossima'}>
                {property.statusLabel}
              </span>
              <span class="font-body text-xs text-stone-500 tracking-wide">{property.type}</span>
            </div>

            <h1 class="font-display text-5xl md:text-6xl text-stone-100 font-light mb-4">
              {property.title}
            </h1>

            <div class="flex items-center gap-2 mb-8">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" class="text-brand-500">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
                <circle cx="12" cy="9" r="2.5"/>
              </svg>
              <span class="font-body text-stone-400">{property.location}</span>
            </div>

            <p class="font-body text-stone-300 leading-relaxed text-lg">
              {property.longDescription}
            </p>
          </div>

          <!-- Work progress -->
          <div class="mt-12 reveal">
            <span class="gold-line"></span>
            <h2 class="font-display text-3xl text-stone-100 font-light mb-6">
              Avanzamento Lavori
            </h2>
            <div class="bg-stone-900 border border-stone-800 p-6">
              <div class="flex items-center justify-between mb-3">
                <span class="font-body text-sm text-stone-300">{property.workProgressLabel}</span>
                <span class="font-display text-2xl font-light"
                      style={`color: ${progressColor(property.workProgress)}`}>
                  {property.workProgress}%
                </span>
              </div>
              <!-- Progress bar -->
              <div class="w-full bg-stone-800 h-1.5">
                <div
                  class="h-1.5 transition-all duration-1000"
                  style={`width: ${property.workProgress}%; background: ${progressColor(property.workProgress)};`}
                ></div>
              </div>
              <!-- Available from -->
              <div class="mt-5 flex items-center gap-3">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.5" class="text-brand-500 flex-shrink-0">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                  <line x1="16" y1="2" x2="16" y2="6"/>
                  <line x1="8" y1="2" x2="8" y2="6"/>
                  <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                <span class="font-body text-sm text-stone-400">
                  Disponibile a partire da:&nbsp;
                  <strong class="text-stone-200 font-medium">{property.availableFrom}</strong>
                </span>
              </div>
            </div>
          </div>

          <!-- Features -->
          <div class="mt-12 reveal">
            <span class="gold-line"></span>
            <h2 class="font-display text-3xl text-stone-100 font-light mb-8">
              Caratteristiche
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              {property.features.map((feature: string) => (
                <div class="flex items-center gap-3 py-3 border-b border-stone-800">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                       stroke-width="2" class="text-brand-500 flex-shrink-0">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <span class="font-body text-sm text-stone-300">{feature}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Planimetrie + PDF download -->
          <div class="mt-12 reveal">
            <span class="gold-line"></span>
            <div class="flex items-center justify-between mb-8 flex-wrap gap-4">
              <h2 class="font-display text-3xl text-stone-100 font-light">
                Planimetrie
              </h2>
              {property.pdfUrl && (
                <a
                  href={property.pdfUrl}
                  download
                  class="inline-flex items-center gap-2 font-body text-xs tracking-widest uppercase
                         border border-brand-700 text-brand-400 px-5 py-3
                         hover:bg-brand-500 hover:text-stone-950 hover:border-brand-500
                         transition-all duration-300"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <line x1="12" y1="15" x2="12" y2="3"/>
                  </svg>
                  Scarica PDF planimetrie
                </a>
              )}
            </div>
            <div class="bg-stone-900 border border-stone-800 h-64 flex items-center justify-center">
              <p class="font-body text-stone-500 text-sm">
                {property.pdfUrl ? 'Planimetrie disponibili nel PDF allegato' : 'Planimetrie disponibili su richiesta'}
              </p>
            </div>
          </div>

        </div>

        <!-- Right: sidebar -->
        <div class="lg:col-span-1">
          <div class="sticky top-28 space-y-6">

            <!-- Units table -->
            <div class="bg-stone-900 border border-stone-800 p-6 reveal">
              <h3 class="font-display text-2xl text-stone-100 font-light mb-6">
                Unità Disponibili
              </h3>
              <div class="space-y-4">
                {property.units.map((unit: any) => (
                  <div class={`p-4 border ${unit.available ? 'border-stone-700' : 'border-stone-800 opacity-50'}`}>
                    <!-- Type + badge -->
                    <div class="flex justify-between items-start mb-3">
                      <span class="font-display text-lg text-stone-100">{unit.type}</span>
                      {unit.available
                        ? <span class="badge-vendita">Disponibile</span>
                        : <span class="badge-venduto">Venduto</span>
                      }
                    </div>
                    <!-- 4-cell detail grid -->
                    <div class="grid grid-cols-2 gap-x-4 gap-y-3">
                      <div>
                        <span class="font-body text-xs text-stone-500 block">Superficie</span>
                        <span class="font-body text-sm text-stone-300">{unit.size}</span>
                      </div>
                      <div>
                        <span class="font-body text-xs text-stone-500 block">Piano</span>
                        <span class="font-body text-sm text-stone-300">{unit.floor}</span>
                      </div>
                      {unit.exposure && (
                        <div>
                          <span class="font-body text-xs text-stone-500 block">Esposizione</span>
                          <span class="font-body text-sm text-stone-300">{unit.exposure}</span>
                        </div>
                      )}
                      {unit.balcony && (
                        <div>
                          <span class="font-body text-xs text-stone-500 block">Esterno</span>
                          <span class="font-body text-sm text-stone-300">{unit.balcony}</span>
                        </div>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Contact CTA box -->
            <div class="bg-stone-900 border border-brand-700 p-6 reveal delay-200">
              <h3 class="font-display text-2xl text-stone-100 font-light mb-2">
                Interessato?
              </h3>
              <p class="font-body text-sm text-stone-400 mb-6">
                Contattaci per informazioni, prezzi e per fissare una visita.
              </p>
              <a href={contactUrl} class="btn-primary w-full justify-center mb-3">
                Richiedi Informazioni
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
              <a href="tel:+390332000000" class="btn-outline w-full justify-center text-xs">
                Chiama Ora
              </a>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
