---
interface Props {
  id: string;
  title: string;
  location: string;
  status: string;
  statusLabel: string;
  type: string;
  description: string;
  coverImage: string;
}

const { id, title, location, status, statusLabel, type, description, coverImage } = Astro.props;

// Definiamo se la proprietà è cliccabile
const isAvailable = status === 'in-vendita';

const badgeClass = {
  'in-vendita': 'badge-vendita',
  'prossimamente': 'badge-prossima',
  'venduto': 'badge-venduto',
}[status] ?? 'badge-prossima';
---

<article class={`property-card group ${!isAvailable ? 'opacity-75' : ''}`}>
  {isAvailable ? (
    <a href={`/unita-in-vendita/${id}`} class="block relative h-72 overflow-hidden">
      <img src={coverImage} alt={title} class="card-image" loading="lazy" width="800" height="600" />
      <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-transparent to-transparent opacity-60"></div>
      
      <div class="absolute top-4 left-4">
        <span class={badgeClass}>{statusLabel}</span>
      </div>

      <div class="absolute bottom-4 left-4">
        <span class="font-body text-xs text-stone-300 bg-stone-950/80 px-3 py-1 backdrop-blur-sm">{type}</span>
      </div>
    </a>
  ) : (
    <div class="block relative h-72 overflow-hidden cursor-default">
      <img src={coverImage} alt={title} class="card-image grayscale-[0.5]" loading="lazy" width="800" height="600" />
      <div class="absolute inset-0 bg-stone-900/40"></div>
      
      <div class="absolute top-4 left-4">
        <span class={badgeClass}>{statusLabel}</span>
      </div>

      <div class="absolute bottom-4 left-4">
        <span class="font-body text-xs text-stone-300 bg-stone-950/80 px-3 py-1 backdrop-blur-sm">{type}</span>
      </div>
    </div>
  )}

  <div class="p-6 border-t border-stone-800">
    <div class="flex items-start justify-between gap-4 mb-3">
      <h3 class={`font-display text-2xl text-stone-100 font-light ${isAvailable ? 'group-hover:text-brand-400' : ''} transition-colors duration-300`}>
        {isAvailable ? (
          <a href={`/unita-in-vendita/${id}`}>{title}</a>
        ) : (
          <span>{title}</span>
        )}
      </h3>
    </div>

    <div class="flex items-center gap-2 mb-4">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" class="text-brand-500 flex-shrink-0">
        <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
        <circle cx="12" cy="9" r="2.5"/>
      </svg>
      <span class="font-body text-xs text-stone-500 tracking-wide">{location}</span>
    </div>

    <p class="font-body text-sm text-stone-400 leading-relaxed line-clamp-2 mb-6">
      {description}
    </p>

    {isAvailable ? (
      <a
        href={`/unita-in-vendita/${id}`}
        class="inline-flex items-center gap-2 font-body text-xs tracking-widest uppercase
               text-brand-400 hover:text-brand-300 transition-colors duration-200 group/link"
      >
        Scopri di più
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" class="transform group-hover/link:translate-x-1 transition-transform duration-200">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    ) : (
      <span class="inline-flex items-center gap-2 font-body text-xs tracking-widest uppercase text-stone-600 cursor-default">
        Non disponibile
      </span>
    )}
  </div>
</article>